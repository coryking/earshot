#!/usr/bin/env bash
# radio-borrow: run a command that needs the Pluto while the always-on receiver steps aside.
#
#   offload/radio-borrow [--lock] CMD [ARGS...]
#
# 1. stops amateur-radio-live (the supervisor): it stops the producer, reads the radio back
#    against the settings it found (correcting them if needed), and releases
#    /tmp/pluto-radio.lock. The public page keeps running and says the receiver is away.
# 2. runs CMD. CMD takes /tmp/pluto-radio.lock itself, as every radio session must
#    (`flock /tmp/pluto-radio.lock ...`, or offload/radio_lock.py).
#    With --lock, radio-borrow holds the lock around CMD instead, for commands that do not.
# 3. when CMD ends, however it ends (exit, Ctrl-C, SIGTERM), starts amateur-radio-live again,
#    unless another borrower is still running: the last one out resumes it.
#
# The exit status is CMD's. 125 means the live service would not stop, and CMD was not run.
# If radio-borrow itself is killed with SIGKILL, amateur-radio-borrow-guard.timer resumes
# the live service within two minutes. Without the live unit installed (another box), CMD is
# simply run, so scripts can call this unconditionally.
#
# Tell the human the radio is in use rather than leaving it stopped: nothing else is needed.
set -u

UNIT=amateur-radio-live.service
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/amateur-radio"
STATUS="$RUN/receiver.json"
MARKER="$RUN/borrow-resume"        # exists while live should be started when the last borrower leaves
MUTEX="$RUN/borrow.mutex"          # serializes stop/resume decisions between borrowers
BORROWERS="${PLUTO_RADIO_BORROW_LOCK:-/tmp/pluto-radio-borrow.lock}"   # each borrower holds it shared while it runs
RADIO_LOCK="${PLUTO_RADIO_LOCK:-/tmp/pluto-radio.lock}"

say() { echo "radio-borrow: $*" >&2; }

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

live_installed() {
  command -v systemctl >/dev/null 2>&1 &&
    [ "$(systemctl --user show -p LoadState --value "$UNIT" 2>/dev/null)" = "loaded" ]
}

live_running() {
  case "$(systemctl --user show -p ActiveState --value "$UNIT" 2>/dev/null)" in
    active|activating|reloading|deactivating) return 0 ;;
    *) return 1 ;;
  esac
}

write_status() {  # state detail
  local now; now=$(date +%s)
  printf '{"state":"%s","reason":null,"detail":"%s","since":%s,"updated":%s,"fresh":true}\n' \
    "$1" "$2" "$now" "$now" > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
}

# Called with the mutex held and no borrower left: start live again if we stopped it.
resume_if_due() {
  [ -e "$MARKER" ] || return 0
  rm -f "$MARKER"
  say "starting $UNIT again"
  systemctl --user start "$UNIT" || say "WARNING: $UNIT did not start; run: systemctl --user start $UNIT"
}

no_other_borrowers() {  # fd 7 is opened by the caller
  flock -xn 7
}

if [ "${1:-}" = "--resume-orphaned" ]; then
  # Run by the guard timer: resume live if a borrower died without cleaning up.
  live_installed || exit 0
  mkdir -p "$RUN"
  exec 9>"$MUTEX"; flock 9
  exec 7>"$BORROWERS"
  if no_other_borrowers && [ -e "$MARKER" ] && ! live_running; then
    say "no borrower is running; resuming $UNIT"
    resume_if_due
  fi
  exit 0
fi

case "${1:-}" in
  -h|--help|"") usage; [ -n "${1:-}" ] && exit 0; exit 2 ;;
esac

hold_lock=0
if [ "$1" = "--lock" ]; then hold_lock=1; shift; fi
[ $# -gt 0 ] || { usage; exit 2; }

if ! live_installed; then
  export PLUTO_RADIO_BORROWED=1
  if [ $hold_lock = 1 ]; then exec flock "$RADIO_LOCK" env PLUTO_RADIO_LOCK_HELD=1 "$@"; fi
  exec "$@"
fi

mkdir -p "$RUN"
exec 8>"$BORROWERS"
flock -s 8                      # I am a borrower from here until I exit

finish() {
  trap - EXIT
  exec 8>&-                     # no longer a borrower
  exec 9>"$MUTEX"; flock 9
  exec 7>"$BORROWERS"
  if no_other_borrowers; then resume_if_due; else say "another borrower is still running; leaving live stopped"; fi
}
trap 'finish' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP     # until the command starts; then they are forwarded to it

exec 9>"$MUTEX"; flock 9        # stop decisions are made one borrower at a time
if live_running; then
  : > "$MARKER"
  say "stopping $UNIT (it restores the radio and releases the lock)"
  if ! systemctl --user stop "$UNIT"; then
    rm -f "$MARKER"
    say "ERROR: $UNIT would not stop; not running the command"
    exit 125
  fi
fi
restore=$(jq -r '.last_restore // empty' "$STATUS" 2>/dev/null)
write_status borrowed "The receiver is being used for a test and comes back when that finishes."
[ -n "$restore" ] && say "radio restored by the live service: $restore"
exec 9>&-                       # let other borrowers in

export PLUTO_RADIO_BORROWED=1
if [ $hold_lock = 1 ]; then
  flock "$RADIO_LOCK" env PLUTO_RADIO_LOCK_HELD=1 "$@" <&0 8>&- &
else
  "$@" <&0 8>&- &
fi
child=$!
# Signals sent to radio-borrow alone are passed on; cleanup waits for the command to be done.
trap 'kill -TERM "$child" 2>/dev/null' TERM HUP
trap 'kill -INT "$child" 2>/dev/null' INT
rc=0
while kill -0 "$child" 2>/dev/null; do wait "$child"; rc=$?; done
exit $rc
